{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IceKube",
  "version": "0.0.1-pre.2",
  "identifier": "ad.yan.icekube",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "IceKube",
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 320,
        "maximized": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/yan-ad/icekube/releases/latest/download/latest.json"
      ]
    }
  }
}
